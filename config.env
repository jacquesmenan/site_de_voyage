SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# =================================
# LOGGING
# =================================
LOG_LEVEL=debug
LOG_FORMAT=dev

# =================================
# RATE LIMITING
# =================================
RATE_LIMIT_WINDOW_MS=3600000 # 1 heure
RATE_LIMIT_MAX=1000 # Nombre maximum de requêtes par fenêtre

# =================================
# UPLOAD
# =================================
MAX_FILE_UPLOAD=2097152 # 2MB
UPLOAD_PATH=public/img/users

# =================================
# AUTRES CONFIGURATIONS
# =================================
NODE_TLS_REJECT_UNAUTHORIZED=0 # Désactive la vérification TLS (uniquement pour le développement)

# =================================
# NOTES IMPORTANTES
