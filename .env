# =================================
# ENVIRONNEMENT ET CONFIGURATION GÉNÉRALE
# =================================
NODE_ENV=development
PORT=3000
HOST=localhost

# =================================
# CONFIGURATION O2SWITCH MYSQL
# =================================
# Remplacer avec vos informations o2switch (panneau client > Bases de données > MySQL)
DB_HOST=mysql-[VOTRE_IDENTIFIANT].o2switch.net
DB_USER=[VOTRE_IDENTIFIANT]_[UTILISATEUR_BDD]
DB_PASSWORD=[VOTRE_MOT_DE_PASSE_BDD]
DB_NAME=[VOTRE_IDENTIFIANT]_[NOM_BDD]
DB_PORT=3306

# =================================
# SÉCURITÉ ET AUTHENTIFICATION
# =================================
# Générer une clé avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplacez_par_une_cle_secrete_longue_et_securisee
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
JWT_COOKIE_SECURE=true
JWT_COOKIE_HTTPONLY=true
JWT_COOKIE_SAMESITE=Strict

# Configuration CORS
CORS_ORIGIN_DEV=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_PROD=https://www.cedricdubaisolutions.com,https://cedricdubaisolutions.com

# Limite de tentatives de connexion
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=30 # minutes

# =================================
# EMAIL (SENDGRID)
# =================================
EMAIL_FROM=Cédric Dubai Solutions <contact@cedricdubaisolutions.com>
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USERNAME=apikey
EMAIL_PASSWORD=votre_cle_api_sendgrid
SENDGRID_API_KEY=votre_cle_api_sendgrid

# =================================
# SESSIONS ET COOKIES
# =================================
SESSION_SECRET=remplacez_par_une_autre_cle_secrete
SESSION_COOKIE_NAME=cedric_dubai_solutions_sid
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict
SESSION_COOKIE_MAX_AGE=86400000 # 1 jour en millisecondes

# =================================
# UPLOAD DE FICHIERS
# =================================
FILE_UPLOAD_PATH=public/img/users
MAX_FILE_UPLOAD=2097152 # 2MB
IMAGE_RESIZE_WIDTH=500
IMAGE_RESIZE_HEIGHT=500
IMAGE_QUALITY=90

# =================================
# PERFORMANCE
# =================================
CACHE_ENABLED=true
CACHE_TTL=3600 # 1 heure en secondes
COMPRESSION_LEVEL=6

# =================================
# DÉVELOPPEMENT
# =================================
DEBUG=app:*
NODE_OPTIONS=--max-old-space-size=1024

# =================================
# LIENS
# =================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
API_BASE_URL=/api/v1