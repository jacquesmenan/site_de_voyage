# =================================
# CONFIGURATION SUPABASE
# =================================
SUPABASE_URL=votre_url_supabase
SUPABASE_ANON_KEY=votre_cle_anonyme_supabase
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_supabase # Pour les opérations côté serveur sécurisées

# =================================
# CONFIGURATION JWT (JSON Web Tokens)
# =================================
JWT_SECRET=votre_secret_jwt_pour_les_tokens
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES=90

# =================================
# AUTRES CONFIGURATIONS
# =================================
NODE_ENV=development
PORT=3000

# URL de base de votre application (sans le / final)
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:3000

# Configuration des emails (si nécessaire)
# EMAIL_FROM=contact@votresite.com
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USERNAME=votre_username
# EMAIL_PASSWORD=votre_mot_de_passe
