# =================================
# ENVIRONNEMENT ET CONFIGURATION GÉNÉRALE
# =================================
NODE_ENV=development
PORT=3000
HOST=localhost

# =================================
# BASE DE DONNÉES MONGODB
# =================================
DATABASE=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.example.mongodb.net/<DATABASE>?retryWrites=true&w=majority
DATABASE_PASSWORD=your_database_password
DATABASE_LOCAL=mongodb://localhost:27017/cedric-dubai-solutions

# =================================
# SÉCURITÉ ET AUTHENTIFICATION
# =================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
JWT_COOKIE_SECURE=true
JWT_COOKIE_HTTPONLY=true
JWT_COOKIE_SAMESITE=Strict

# Durée de validité des jetons de réinitialisation de mot de passe (en minutes)
PASSWORD_RESET_TOKEN_EXPIRES=30

# Limite de tentatives de connexion avant verrouillage du compte
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=30 # en minutes

# Configuration CORS
CORS_ORIGIN_DEV=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_PROD=https://www.cedricdubaisolutions.com,https://cedricdubaisolutions.com

# =================================
# CONFIGURATION EMAIL
# =================================

# Configuration pour la production (SendGrid)
EMAIL_FROM=Cédric Dubai Solutions <contact@cedricdubaisolutions.com>

# Configuration pour le développement (Mailtrap)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=ab5d220161f687
EMAIL_PASSWORD=d8119b4d022ef0

# Configuration pour la production (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_USERNAME=apikey
SENDGRID_PASSWORD=your_sendgrid_api_key

# Modèles d'emails (optionnel, utilisé si vous utilisez SendGrid Transactional Templates)
SENDGRID_WELCOME_TEMPLATE_ID=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_PASSWORD_RESET_TEMPLATE_ID=d-yyyyyyyyyyyyyyyyyyyyyyyyyyyy
SENDGRID_BOOKING_CONFIRMATION_TEMPLATE_ID=d-zzzzzzzzzzzzzzzzzzzzzzzzzzzz
SENDGRID_CONTACT_TEMPLATE_ID=d-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# =================================
# PAIEMENTS (STRIPE)
# =================================
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PUBLIC_KEY=your_stripe_public_key
CURRENCY=eur

# ID des produits Stripe (à remplacer par les vôtres)
STRIPE_PRODUCT_VOYAGE=prod_xxxxxxxxxxxxxxxx
STRIPE_PRODUCT_EXPAT=prod_yyyyyyyyyyyyyyyy

# =================================
# ANALYTICS ET SUIVI
# =================================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
FACEBOOK_PIXEL_ID=XXXXXXXXXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# =================================
# SÉCURITÉ AVANCÉE
# =================================
# Configuration du taux de requêtes (rate limiting)
RATE_LIMIT_WINDOW_MS=3600000 # 1 heure en millisecondes
RATE_LIMIT_MAX=100 # Nombre maximum de requêtes par fenêtre

# Configuration de la politique de sécurité du contenu (CSP)
CSP_REPORT_URI=/api/v1/security/csp-report

# Configuration Helmet (sécurité des en-têtes HTTP)
HELMET_HSTS_ENABLED=true
HELMET_HSTS_MAX_AGE=31536000 # 1 an en secondes
HELMET_HSTS_INCLUDE_SUBDOMAINS=true
HELMET_HSTS_PRELOAD=true

# =================================
# UPLOAD DE FICHIERS
# =================================
# Configuration pour le stockage des fichiers
FILE_UPLOAD_PATH=public/img/users
MAX_FILE_UPLOAD=2097152 # 2MB en octets

# Configuration pour les images
IMAGE_RESIZE_WIDTH=500
IMAGE_RESIZE_HEIGHT=500
IMAGE_QUALITY=90 # Qualité de compression (0-100)

# =================================
# SESSIONS ET COOKIES
# =================================
SESSION_SECRET=your_session_secret
SESSION_COOKIE_NAME=cedric_dubai_solutions_sid
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict
SESSION_COOKIE_MAX_AGE=86400000 # 1 jour en millisecondes

# =================================
# LOGGING
# =================================
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE=logs/app.log
ERROR_LOG_FILE=logs/error.log

# =================================
# PERFORMANCE
# =================================
# Configuration du cache
CACHE_ENABLED=true
CACHE_TTL=3600 # Durée de vie du cache en secondes (1 heure)

# Configuration de la compression
COMPRESSION_LEVEL=6 # Niveau de compression (1-9)

# =================================
# MISE EN PRODUCTION
# =================================
# Configuration pour Nginx (exemple)
TRUST_PROXY=1
BEHIND_PROXY=true

# Configuration pour PM2 (gestion des processus)
INSTANCES=max
NODE_OPTIONS=--max-old-space-size=1024

# =================================
# DÉVELOPPEMENT ET DÉBOGAGE
# =================================
DEBUG=app:*,express:*,mongoose:*,http:request
NODE_OPTIONS_DEV=--inspect=0.0.0.0:9229

# =================================
# LIENS IMPORTANTS
# =================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_BASE_URL=/api/v1

# =================================
# VERSIONS
# =================================
APP_VERSION=1.0.0
NODE_VERSION=18.0.0
NPM_VERSION=9.0.0

# =================================
# NOTES
# =================================
# 1. Renommez ce fichier en .env pour l'environnement de développement
# 2. Pour la production, créez un fichier .env.production avec des valeurs appropriées
# 3. Ne committez jamais de fichiers .env contenant des clés secrètes
# 4. Utilisez des variables d'environnement système pour les déploiements en production
