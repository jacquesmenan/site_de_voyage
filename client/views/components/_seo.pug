//- Composant SEO réutilisable
//- Utilisation :
//-   include components/_seo
//-   +seo({
//-     title: 'Titre de la page',
//-     description: 'Description de la page',
//-     url: 'https://example.com/page',
//-     image: 'https://example.com/image.jpg',
//-     type: 'website',
//-     keywords: 'mot-clé1, mot-clé2, mot-clé3',
//-     publishedTime: '2023-01-01T00:00:00+01:00',
//-     modifiedTime: '2023-01-01T00:00:00+01:00',
//-     author: 'Auteur',
//-     section: 'Section',
//-     tag: 'Tag',
//-     twitterCard: 'summary_large_image'
//-   })

mixin seo(seoData)
  //- Titre de la page (max 60 caractères)
  - const pageTitle = seoData.title ? `${seoData.title} | Cédric Dubai Solutions` : 'Cédric Dubai Solutions | Votre expert pour Dubaï'
  - const pageDescription = seoData.description || 'Découvrez des expériences uniques à Dubaï avec Cédric Dubai Solutions. Forfaits voyage et services d\'expatriation sur mesure.'
  - const pageUrl = seoData.url || 'https://www.cedricdubaisolutions.com'
  - const pageImage = seoData.image || 'https://www.cedricdubaisolutions.com/img/og-image.jpg'
  - const pageType = seoData.type || 'website'
  - const pageKeywords = seoData.keywords || 'Dubaï, voyage, expatriation, forfaits, tourisme, conseils, Cédric Dubai Solutions'
  - const siteName = 'Cédric Dubai Solutions'
  - const twitterHandle = '@cedricdubai'
  - const twitterCard = seoData.twitterCard || 'summary_large_image'
  - const locale = 'fr_FR'

  //- Balises Meta de base
  title= pageTitle
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  meta(http-equiv='X-UA-Compatible' content='ie=edge')
  meta(name='description' content=pageDescription)
  meta(name='keywords' content=pageKeywords)
  meta(name='author' content=siteName)
  meta(name='robots' content='index, follow')
  
  //- Favicon
  link(rel='icon' type='image/svg+xml' href='/assets/logo.svg')
  
  //- Balises Open Graph (Facebook, LinkedIn, etc.)
  meta(property='og:title' content=pageTitle)
  meta(property='og:description' content=pageDescription)
  meta(property='og:url' content=pageUrl)
  meta(property='og:type' content=pageType)
  meta(property='og:image' content=pageImage)
  meta(property='og:site_name' content=siteName)
  meta(property='og:locale' content=locale)
  
  //- Balises Twitter Card
  meta(name='twitter:card' content=twitterCard)
  meta(name='twitter:site' content=twitterHandle)
  meta(name='twitter:creator' content=twitterHandle)
  meta(name='twitter:title' content=pageTitle)
  meta(name='twitter:description' content=pageDescription)
  meta(name='twitter:image' content=pageImage)
  
  //- Balises supplémentaires
  link(rel='canonical' href=pageUrl)
  
  //- Données structurées Schema.org
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "#{pageType === 'article' ? 'Article' : 'WebSite'}",
      "name": "#{pageTitle}",
      "url": "#{pageUrl}",
      "description": "#{pageDescription}",
      "publisher": {
        "@type": "Organization",
        "name": "#{siteName}",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.cedricdubaisolutions.com/img/logo.png"
        }
      },
      "image": "#{pageImage}",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "#{pageUrl}"
      }#{
        seoData.publishedTime ? `,
      "datePublished": "${seoData.publishedTime}",
      "dateModified": "${seoData.modifiedTime || seoData.publishedTime}",
      "author": {
        "@type": "Person",
        "name": "${seoData.author || siteName}"` : ''
      }#{
        seoData.section ? `,
      "articleSection": "${seoData.section}"` : ''
      }#{
        seoData.tag ? `,
      "keywords": "${seoData.tag}"` : ''
      }
    }
  
  //- Balises supplémentaires pour les articles
  if seoData.publishedTime
    meta(property='article:published_time' content=seoData.publishedTime)
    meta(property='article:modified_time' content=seoData.modifiedTime || seoData.publishedTime)
    meta(property='article:author' content=seoData.author || siteName)
    
    if seoData.section
      meta(property='article:section' content=seoData.section)
      
    if seoData.tag
      meta(property='article:tag' content=seoData.tag)
  
  //- Favicon
  link(rel='apple-touch-icon' sizes='180x180' href='/img/favicon/apple-touch-icon.png')
  link(rel='icon' type='image/png' sizes='32x32' href='/img/favicon/favicon-32x32.png')
  link(rel='icon' type='image/png' sizes='16x16' href='/img/favicon/favicon-16x16.png')
  link(rel='manifest' href='/img/favicon/site.webmanifest')
  link(rel='mask-icon' href='/img/favicon/safari-pinned-tab.svg' color='#0A1A2F')
  meta(name='msapplication-TileColor' content='#0A1A2F')
  meta(name='theme-color' content='#0A1A2F')
  
  //- Préchargement des polices
  link(rel='preconnect' href='https://fonts.googleapis.com')
  link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
  link(rel='preload' as='style' href='https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Open+Sans:wght@300;400;600&display=swap')
  
  //- Préchargement des ressources critiques
  link(rel='preload' as='image' href='/img/hero-bg.jpg')
  link(rel='preload' as='script' href='/js/main.js')
  
  //- Balises pour les performances
  meta(name='format-detection' content='telephone=no')
  meta(http-equiv='x-ua-compatible' content='ie=edge')
  
  //- Balises pour les applications web progressives (PWA)
  link(rel='manifest' href='/manifest.json')
  meta(name='mobile-web-app-capable' content='yes')
  meta(name='apple-mobile-web-app-capable' content='yes')
  meta(name='apple-mobile-web-app-status-bar-style' content='black-translucent')
  meta(name='apple-mobile-web-app-title' content=siteName)
  
  //- Balises pour le partage sur les réseaux sociaux
  meta(property='og:site_name' content=siteName)
  meta(property='og:locale' content=locale)
  meta(property='og:image:width' content='1200')
  meta(property='og:image:height' content='630')
  
  //- Balises pour les cartes Twitter
  meta(name='twitter:image:alt' content=pageTitle)
  meta(name='twitter:site' content=twitterHandle)
  meta(name='twitter:creator' content=twitterHandle)
