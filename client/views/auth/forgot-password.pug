extends ../base

block content
  main.main
    .forgot-password-form
      h2.heading-secondary.ma-bt-lg Mot de passe oublié ?
      form.form.form--forgot-password
        .form__group
          label.form__label(for='email') Adresse email
          input#email.form__input(
            type='email', 
            placeholder='vous@exemple.com', 
            required
          )
        .form__group
          button.btn.btn--green Envoyer le lien de réinitialisation
